// Schema Postgres (Seção 57 do prompt mestre: troca de camada de persistência,
// Excel -> banco de verdade, decidida com o usuário em 2026-09-16).
//
// Um schema Postgres por módulo (cadastros, financeiro, orcamento, comercial,
// planejamento, configuracoes, auditoria), espelhando os 7 arquivos .xlsx de
// hoje (backend/src/schema/files.ts é a fonte de verdade original -- este
// arquivo é gerado a partir dela, coluna por coluna).
//
// Decisões confirmadas com o usuário (não mudar sem nova confirmação):
// - IDs continuam strings com prefixo geradas pela aplicação (ALU_000001 etc.),
//   não serial/UUID nativo -- toda coluna de ID aqui é só `String @id`.
// - Colunas "number" do schema original viram Decimal(12,2) no Postgres (mais
//   seguro que float para dinheiro); a aplicação sempre recebe/devolve JS
//   number puro (conversão feita no PostgresRepository, nunca Decimal
//   vazando para o resto do código).
// - Colunas enum viram TEXT (String) + CHECK constraint (adicionada via SQL
//   bruto na migration, não como enum nativo do Postgres -- mais fácil de
//   estender a lista de valores permitidos no futuro).
// - Nenhuma FK real (@relation) entre tabelas: a checagem de integridade
//   referencial (inclusive cross-schema, ex.: Negociacoes.ID_ALUNO ->
//   cadastros.Alunos) continua 100% em CrudService.checkForeignKeys
//   (inalterado) -- um FK real do banco não expressaria a regra "alvo
//   precisa estar ATIVO", que é mais restritiva que uma FK comum.
//
// Colisão de nome de tabela (achado ao escrever este arquivo, sem uso ativo
// hoje): TiposReceita, TiposDespesa, FormasPagamento e CentrosCusto existem
// tanto no módulo "dono" (financeiro/cadastros, ativo) quanto em
// "configuracoes" (schema inteiro ainda sem nenhuma rota implementada, só
// preparado para o futuro -- ver CLAUDE.md). Prisma exige nome de modelo
// único no arquivo inteiro, mesmo com schemas Postgres diferentes -- por
// isso as 4 cópias dormentes em "configuracoes" ganham o prefixo
// "Configuracoes" no nome do modelo Prisma, mas mantêm o nome de tabela
// físico original via @@map (não afeta nenhum código ativo).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a URL de conexão não vai mais aqui -- fica em prisma.config.ts
// (CLI: migrate/db push/studio) e é passada via driver adapter (@prisma/adapter-pg)
// na construção do PrismaClient em runtime (backend/src/repository/prismaClient.ts).
datasource db {
  provider = "postgresql"
  schemas  = ["cadastros", "financeiro", "orcamento", "comercial", "planejamento", "configuracoes", "auditoria"]
}

// ============================================================
// 01_CADASTROS.xlsx -> schema "cadastros"
// ============================================================

model Alunos {
  ID_ALUNO                String   @id
  NOME                    String
  DATA_NASCIMENTO         DateTime
  GENERO                  String?
  ID_SERIE                String?
  ID_TURMA                String?
  ID_TURNO                String?
  NECESSIDADE_ALIMENTACAO Boolean?
  HORARIO_ESPECIAL        String?
  DATA_CADASTRO           DateTime
  ATIVO                   Boolean

  @@schema("cadastros")
}

model Responsaveis {
  ID_RESPONSAVEL String  @id
  NOME           String
  CPF            String?
  EMAIL          String?
  TELEFONE       String?
  ATIVO          Boolean

  @@schema("cadastros")
}

model ResponsaveisFinanceiros {
  ID_ALUNO_RESPONSAVEL String  @id
  ID_ALUNO             String
  ID_RESPONSAVEL       String
  TIPO                 String
  ATIVO                Boolean

  @@schema("cadastros")
}

model AnosLetivos {
  ID_ANO_LETIVO String  @id
  ANO           Decimal @db.Decimal(12, 2)
  ATIVO         Boolean

  @@schema("cadastros")
}

model Series {
  ID_SERIE      String  @id
  NOME          String
  NIVEL_ENSINO  String?
  ID_ANO_LETIVO String
  ATIVO         Boolean

  @@schema("cadastros")
}

model Turmas {
  ID_TURMA          String  @id
  ID_SERIE          String
  NOME              String
  ID_TURNO          String?
  ID_SALA           String?
  CAPACIDADE_MAXIMA Decimal @db.Decimal(12, 2)
  ATIVO             Boolean

  @@schema("cadastros")
}

model Salas {
  ID_SALA    String  @id
  NOME       String
  CAPACIDADE Decimal @db.Decimal(12, 2)
  ATIVO      Boolean

  @@schema("cadastros")
}

model Turnos {
  ID_TURNO String  @id
  NOME     String
  ATIVO    Boolean

  @@schema("cadastros")
}

model Modalidades {
  ID_MODALIDADE String  @id
  NOME          String
  ATIVO         Boolean

  @@schema("cadastros")
}

model Funcionarios {
  ID_FUNCIONARIO String   @id
  NOME           String
  ID_CARGO       String
  ID_EQUIPE      String?
  SALARIO_BRUTO  Decimal? @db.Decimal(12, 2)
  ATIVO          Boolean

  @@schema("cadastros")
}

model Cargos {
  ID_CARGO String  @id
  NOME     String
  ATIVO    Boolean

  @@schema("cadastros")
}

model Equipes {
  ID_EQUIPE String  @id
  NOME      String
  ATIVO     Boolean

  @@schema("cadastros")
}

model CentrosCusto {
  ID_CENTRO_CUSTO String  @id
  NOME            String
  ATIVO           Boolean

  @@schema("cadastros")
}

